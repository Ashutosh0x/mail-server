# Mail Server configuration — copy to .env and fill in.
# Never commit .env. Every value here is read by the SERVER; none is baked into
# the browser bundle. The client learns limits from GET /api/config.

# ── Database ──────────────────────────────────────────────────────────────
# Production target. Applied with `npm run db:migrate`.
DATABASE_URL=postgresql://mailserver:change-me@localhost:5432/mailserver
# Local development uses SQLite (node:sqlite, no native module required).
DATABASE_FILE=.data/mailserver.db

# ── Cache / queue ─────────────────────────────────────────────────────────
VALKEY_URL=redis://localhost:6379

# ── Mail transport ────────────────────────────────────────────────────────
# Leave SMTP_HOST unset and sending is DISABLED and says so in the UI, rather
# than accepting a message it cannot deliver.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Permit an UNENCRYPTED SMTP connection. Off by default: requireTLS otherwise
# makes the connection fail rather than silently downgrade. The legitimate use
# is relaying to a trusted MTA on loopback, where traffic never leaves the host.
SMTP_ALLOW_INSECURE=false
IMAP_HOST=
STALWART_API_URL=http://localhost:8080
STALWART_API_TOKEN=

# ── Object storage ────────────────────────────────────────────────────────
# "filesystem" is the only implemented driver. Setting anything else fails at
# startup rather than silently writing to local disk.
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_ROOT=.data/blobs
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Limits ────────────────────────────────────────────────────────────────
# All enforced server-side. The frontend hardcodes none of them.
# Single attachment. Default 100 MB.
MAX_ATTACHMENT_SIZE_BYTES=104857600
# Whole message including every part, before transfer encoding.
MAX_TOTAL_MESSAGE_SIZE_BYTES=157286400
# Ceiling for an EXTERNAL recipient. Base64 inflates by ~37%, so 18 MB here is
# roughly 25 MB on the wire — under the common receiver cap.
MAX_OUTBOUND_MESSAGE_SIZE_BYTES=18874368
# Per-user storage quota.
MAX_USER_STORAGE_BYTES=16106127360
UPLOAD_CHUNK_SIZE_BYTES=8388608
MAX_RECIPIENTS_PER_MESSAGE=100
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=50
SESSION_TTL_SECONDS=2592000

# ── Anti-spam / anti-malware ──────────────────────────────────────────────
RSPAMD_URL=http://localhost:11334
RSPAMD_PASSWORD=
CLAMAV_HOST=

# ── Observability ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────
# RP_ID is the registrable domain a passkey is bound to — never a URL, never
# a port. That binding is what makes a passkey unphishable: a credential for
# one domain simply will not work on another.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Mail Server
# Comma-separated, matched exactly. A wildcard here would defeat the check.
WEBAUTHN_ORIGINS=http://localhost:3000

# ── NFS storage (when OBJECT_STORAGE_DRIVER=nfs) ──────────────────────────
# Refuse to serve if the storage root turns out to be a local directory: an
# unmounted export is still a valid empty folder, and writes would land on
# the wrong disk, invisible to other nodes and to backups.
NFS_REQUIRE_NETWORK_FS=true
NFS_DEGRADED_ABOVE_MS=250

# ── Secrets ───────────────────────────────────────────────────────────
# REQUIRED. The key that seals stored provider credentials (AES-256-GCM, with
# the row id as additional authenticated data, so a sealed value cannot be
# moved to another row). At least 32 characters; the app refuses to start
# without it rather than falling back to a default, because a default key is
# the same as no encryption.
#
# Generate one with:  openssl rand -base64 32
#
# Changing it makes every already-sealed credential unreadable. There is no
# rotation mechanism yet, so treat this as write-once for now.
SECRETS_KEY=
